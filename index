<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contagem para a Reforma</title>

<style>
    body{
        background:#121212;
        color:#ffffff;
        font-family:Arial, sans-serif;
        display:flex;
        justify-content:center;
        align-items:center;
        min-height:100vh;
        margin:0;
    }

    .container{
        background:#1e1e1e;
        padding:30px;
        border-radius:15px;
        box-shadow:0 0 15px rgba(255,255,255,0.1);
        max-width:500px;
        width:90%;
        text-align:center;
    }

    h1{
        color:#4fc3f7;
    }

    input{
        width:80px;
        padding:10px;
        margin:5px;
        border:none;
        border-radius:8px;
        text-align:center;
        background:#2d2d2d;
        color:white;
    }

    button{
        margin-top:15px;
        padding:12px 20px;
        border:none;
        border-radius:8px;
        background:#4fc3f7;
        color:black;
        font-weight:bold;
        cursor:pointer;
    }

    button:hover{
        background:#81d4fa;
    }

    #resultado{
        margin-top:25px;
        font-size:1.2em;
        line-height:1.6;
    }

    .frase{
        margin-top:15px;
        color:#ffd54f;
        font-style:italic;
    }
</style>
</head>
<body>

<div class="container">
    <h1>Quanto Falta para a Reforma?</h1>

    <p>Indique a sua idade atual:</p>

    <input type="number" id="anos" placeholder="Anos" min="0">
    <input type="number" id="meses" placeholder="Meses" min="0" max="11">
    <input type="number" id="dias" placeholder="Dias" min="0" max="31">

    <br>

    <button onclick="calcular()">Calcular</button>

    <div id="resultado"></div>
</div>

<script>
function calcular() {

    const idadeAnos = parseInt(document.getElementById("anos").value) || 0;
    const idadeMeses = parseInt(document.getElementById("meses").value) || 0;
    const idadeDias = parseInt(document.getElementById("dias").value) || 0;

    const reformaAnos = 66;
    const reformaMeses = 7;
    const reformaDias = 0;

    let anos = reformaAnos - idadeAnos;
    let meses = reformaMeses - idadeMeses;
    let dias = reformaDias - idadeDias;

    if (dias < 0) {
        dias += 30;
        meses--;
    }

    if (meses < 0) {
        meses += 12;
        anos--;
    }

    const frases = [
        "Cada dia conta para construir o futuro que deseja.",
        "A reforma é um objetivo, mas o caminho também merece ser vivido.",
        "Continue a investir em si próprio, o melhor ainda pode estar por vir.",
        "O tempo passa depressa. Aproveite cada etapa.",
        "Grandes conquistas são feitas de pequenos passos diários.",
        "Hoje está mais perto da meta do que ontem.",
        "O futuro recompensa quem persevera."
    ];

    const frase = frases[Math.floor(Math.random() * frases.length)];

    let mensagem;

    if (anos < 0 || (anos === 0 && meses === 0 && dias === 0)) {
        mensagem = "🎉 Já atingiu a idade de reforma!";
    } else {
        mensagem = `
            <strong>Faltam:</strong><br>
            ${anos} anos, ${meses} meses e ${dias} dias
            <div class="frase">"${frase}"</div>
        `;
    }

    document.getElementById("resultado").innerHTML = mensagem;
}
</script>

</body>
</html>
